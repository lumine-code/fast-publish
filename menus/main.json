{
  "context-menu": {
    ".tree-view .directory > .list-item": [
      {
        "type": "separator"
      },
      {
        "label": "Git Publish",
        "id": "fast-publish:tree-context",
        "afterGroupContaining": [
          "folder-sync:create",
          "folder-sync:run",
          {
            "id": "terminal:tree-context"
          },
          "tree-view-favourite:add",
          "tree-view-favourite:remove",
          "diff-view:enable",
          "search-panel:project-show-in-current-directory",
          "open-external:show",
          "tree-view:open-selected-entry-up",
          "native-clip:paste",
          "tree-view:paste",
          "tree-view:remove",
          "tree-view:add-file"
        ],
        "submenu": [
          {
            "label": "as Major",
            "command": "fast-publish:git-major"
          },
          {
            "label": "as Minor",
            "command": "fast-publish:git-minor"
          },
          {
            "label": "as Patch",
            "command": "fast-publish:git-patch"
          }
        ]
      },
      {
        "type": "separator"
      }
    ]
  }
}
